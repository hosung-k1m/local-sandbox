# Build outputs
/build/
/dist/
/agent

# Go
*.test
*.out
*.prof
/coverage.txt
/coverage.html

# Editor/OS cruft
.DS_Store
*.swp
.idea/
.vscode/

# Local env / secrets — should never be committed
.env
.env.*
*.pem
*.key
*.p12
*credentials*.json
*secret*
auth.json
config.json

# Local runtime state (BoxedAi state root normally lives at ~/.boxedai,
# but ignore it here too in case BOXEDAI_HOME is pointed at the repo)
.boxedai/

# Logs and traces
*.log
*.jsonl
/traces/

# rp1:start:v0.7.1
!.rp1/
.rp1/*
!.rp1/project_id
!.rp1/config/
!.rp1/config/**
!.rp1/context/
!.rp1/context/**
.rp1/context/meta.json
.rp1/settings.toml
# rp1:end:v0.7.1
